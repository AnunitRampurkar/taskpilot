# copy this to .env and fill in your own values. never commit the real .env

# Neon / Supabase postgres url. leave empty locally to use a sqlite file
DATABASE_URL=

# any long random string. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# Groq key from https://console.groq.com/keys (free)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=30
AGENT_MAX_STEPS=6

# comma separated, no trailing slash. add your vercel url here after deploying
FRONTEND_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata

# demo accounts, created automatically on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
